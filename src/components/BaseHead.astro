  canonical="https://www.lashroom.cz"
  openGraph={{
    basic: {
      title: "lashroom.cz | Profesionální prodlužování řas a kurzy v Olomouci",
      type: "website",
      image: "https://www.lashroom.cz/km.webp",
      url: "https://www.lashroom.cz",
    },
    optional: {
      description: "Profesionální prodlužování řas a kurzy v Olomouci. S více než 8 lety zkušeností a tisíci spokojenými klienty nabízí lashroom.cz jedinečné služby a vzdělání v oblasti krásy.",
      siteName: "lashroom.cz",
    },
    image: {
      url: "https://www.lashroom.cz/km.webp",
      width: 800,
      height: 600,
      alt: "Ilustrace prodlužování řas",
      type: "image/webp",
    },
  }}
  twitter={{
    card: "summary_large_image",
    site: "https://www.lashroom.cz",
    creator: "@lashroom.cz",
    title: "lashroom.cz | Profesionální prodlužování řas a kurzy v Olomouci",
    description: "Profesionální prodlužování řas a kurzy v Olomouci. S více než 8 lety zkušeností a tisíci spokojenými klienty nabízí lashroom.cz jedinečné služby a vzdělání v oblasti krásy.",
    image: "https://www.lashroom.cz/km.webp",
    imageAlt: "Ilustrace prodlužování řas",
  }}
/>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1" />
<meta name="author" content="Katya lashroom.cz" />
<meta name="keywords" content="prodlužování řas Olomouc, kurzy prodlužování řas, lashroom.cz Olomouc, profesionální řasy, beauty kurzy, lash stylist Olomouc, kurzy krásy" />

<Favicons/>
<link rel="preconnect" href="https://rsms.me/" />
<link rel="stylesheet" href="https://rsms.me/inter/inter.css" />

<script defer src="https://unpkg.com/alpinejs@3.x.x/dist/cdn.min.js"></script>
<script is:inline>
  // Dark mode toggle script
  function initTheme() {
    const theme = localStorage.getItem('theme');
    if (theme === 'dark' || (!theme && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
      document.documentElement.classList.add('dark');
    } else {
      document.documentElement.classList.remove('dark');
    }
  }

  function toggleTheme() {
    if (document.documentElement.classList.contains('dark')) {
      localStorage.setItem('theme', 'light');
      document.documentElement.classList.remove('dark');
    } else {
      localStorage.setItem('theme', 'dark');
      document.documentElement.classList.add('dark');
    }
  }

  window.toggleTheme = toggleTheme;
  initTheme();
  document.addEventListener('astro:page-load', () => {
    initTheme();
  });
</script>